# LukitaPort — configuration (copy to .env, or export the variables).
# Every variable is optional unless noted; invalid values stop the server at
# startup with an explicit error (see settings.py).

# ── Access control ───────────────────────────────────────────────────────────
# API token (≥ 16 characters). Optional when listening on 127.0.0.1: a random
# token is generated at each start and a login URL is printed. MANDATORY on
# any other interface (and therefore in Docker).
LUKITA_API_TOKEN=
# Interface and port used by `python run.py`.
LUKITA_HOST=127.0.0.1
LUKITA_PORT=8000
# Host headers accepted (anti DNS-rebinding). Default: 127.0.0.1,localhost,::1
# plus LUKITA_HOST. Add your hostname/IP if you publish it on a LAN.
LUKITA_ALLOWED_HOSTS=
# /api/admin/* (signature reload, status) only exists when true.
LUKITA_ENABLE_ADMIN=false
# Max /api/ requests per client and minute, and max request body size.
LUKITA_RATE_LIMIT=120
LUKITA_MAX_BODY_BYTES=5242880

# ── Concurrency (extra requests get HTTP 429) ────────────────────────────────
LUKITA_MAX_SCANS=2
LUKITA_MAX_NMAP=1
LUKITA_MAX_SCREENSHOTS=2
LUKITA_MAX_AUDITS=2
LUKITA_MAX_SSL=2

# ── SSRF policy ──────────────────────────────────────────────────────────────
# false: loopback, private, link-local, CGNAT, reserved… targets are refused
# (HTTP 403). true ONLY for a lab you own.
ALLOW_PRIVATE_IPS=false

# ── GeoIP (off unless set; local MaxMind GeoLite2 files, no network calls) ───
LUKITA_GEOIP_DB=
LUKITA_GEOIP_ASN_DB=

# ── NVD (CVE lookup). With a key the request spacing drops from 6.2 s to 0.6 s.
NVD_API_KEY=

# ── Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL ───────────────────────
LOG_LEVEL=INFO
